# FenixTeacher Node API — muhit o'zgaruvchilari namunasi

PORT=4000
NODE_ENV=development

# PostgreSQL (fenix-db-schema.sql shu bazaga qo'llaniladi)
DATABASE_URL=postgres://fenix:parol@localhost:5432/fenixteacher

# Telegram Mini App auth uchun (initData tekshirish)
TELEGRAM_BOT_TOKEN=

# initData qancha vaqt "yangi" hisoblanadi (soniyalarda) — bundan
# eski initData rad etiladi (replay attack himoyasi). Standart: 24 soat.
# TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400

# Claude API — barcha AI chaqiruvlari shu orqali, ai_call_logs'ga yoziladi
ANTHROPIC_API_KEY=

# Python PDF-service mikroservisi manzili
PDF_SERVICE_URL=http://localhost:8001

# Ichki endpoint'lar (masalan /internal/ai/infer-units) uchun oddiy
# umumiy maxfiy kalit — mikroservislar orasidagi ishonch uchun
INTERNAL_SERVICE_SECRET=

# PDF-service ham shu qiymatni bilishi kerak (uning ENV'iga qo'shiladi):
# NODE_API_URL=http://localhost:4000
# INTERNAL_SERVICE_SECRET=<xuddi shu qiymat>

# Google Cloud Text-to-Speech (services/tts.ts) — v8'da qo'shildi,
# .env.example'da yo'q edi (deploy vaqtida unutilishi mumkin edi)
GOOGLE_TTS_API_KEY=

# Yuklangan fayllar (PDF/audio) — Cloudflare R2 (S3-mos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fenixteacher
