# FenixTeacher — docker-compose uchun umumiy .env
# Bu faylni .env nomi bilan saqlang va to'ldiring, git'ga qo'shmang.

POSTGRES_PASSWORD=

TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Mini App qaysi domenda joylashganini bot bilsin (WebApp tugmasi uchun).
# 06-mini-app build qilingach shu domenga joylanadi (DEPLOY.md, 6-bo'lim).
MINI_APP_URL=https://fenix.SIZNING-DOMENINGIZ.uz

# Node API va PDF-service orasidagi ichki ishonch kaliti (o'zingiz
# tasodifiy uzun satr o'ylab toping, masalan: openssl rand -hex 32)
INTERNAL_SERVICE_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fenixteacher

# Google Cloud Text-to-Speech (TTS = Google Cloud TTS, Gemini emas).
# https://console.cloud.google.com/apis/credentials — "API key" turi,
# Cloud Text-to-Speech API'ga cheklangan.
GOOGLE_TTS_API_KEY=
